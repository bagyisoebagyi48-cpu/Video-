rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 10 &&
             data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 60 &&
             data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
             data.onlineStatus is string && data.onlineStatus in ['online', 'searching', 'in_call', 'offline'] &&
             data.ageVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // 4. ModerationAction Subcollection (Reports & Blocks)
      function isValidModerationAction(data) {
        return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
               data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
               data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
               data.actionType is string && data.actionType in ['report', 'block'] &&
               data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
               data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
               data.createdAt is timestamp && data.createdAt <= request.time;
      }

      match /moderation_actions/{actionId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(actionId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && existing().userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(actionId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().targetUserId != request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'targetUserId', 'targetCountryCode',
                           'actionType', 'reason', 'roomId', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'targetUserId', 'targetCountryCode',
                           'actionType', 'reason', 'roomId', 'createdAt'
                         ]) &&
                         isValidModerationAction(incoming());

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(userId) && isValidId(actionId) && request.auth.uid == userId;
      }
    }

    // 2. CallRoom Validation Blueprint
    function isValidCallRoom(data) {
      return data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.hostCountryCode is string && data.hostCountryCode.size() >= 2 && data.hostCountryCode.size() <= 10 &&
             data.hostCountryName is string && data.hostCountryName.size() >= 1 && data.hostCountryName.size() <= 60 &&
             data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
             data.guestId is string && data.guestId.size() <= 128 &&
             data.guestName is string && data.guestName.size() <= 60 &&
             data.guestCountryCode is string && data.guestCountryCode.size() <= 10 &&
             data.guestCountryName is string && data.guestCountryName.size() <= 60 &&
             data.status is string && data.status in ['waiting', 'connected', 'ended'] &&
             data.rtcOfferSdp is string && data.rtcOfferSdp.size() <= 5000 &&
             data.rtcAnswerSdp is string && data.rtcAnswerSdp.size() <= 5000 &&
             data.hostFrameData is string && data.hostFrameData.size() <= 8000 &&
             data.guestFrameData is string && data.guestFrameData.size() <= 8000 &&
             data.hostAudioMuted is bool &&
             data.guestAudioMuted is bool &&
             data.hostCameraFacing is string && data.hostCameraFacing in ['front', 'back'] &&
             data.guestCameraFacing is string && data.guestCameraFacing in ['front', 'back'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /call_rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (existing().hostId == request.auth.uid ||
                     existing().guestId == request.auth.uid ||
                     existing().status == 'waiting');

      allow list: if isSignedIn() &&
                     (existing().hostId == request.auth.uid ||
                      existing().guestId == request.auth.uid ||
                      existing().status == 'waiting');

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().guestId == '' &&
                       incoming().status == 'waiting' &&
                       incoming().keys().hasAll([
                         'hostId', 'hostName', 'hostCountryCode', 'hostCountryName',
                         'targetCountryCode', 'guestId', 'guestName', 'guestCountryCode',
                         'guestCountryName', 'status', 'rtcOfferSdp', 'rtcAnswerSdp',
                         'hostFrameData', 'guestFrameData', 'hostAudioMuted', 'guestAudioMuted',
                         'hostCameraFacing', 'guestCameraFacing', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostId', 'hostName', 'hostCountryCode', 'hostCountryName',
                         'targetCountryCode', 'guestId', 'guestName', 'guestCountryCode',
                         'guestCountryName', 'status', 'rtcOfferSdp', 'rtcAnswerSdp',
                         'hostFrameData', 'guestFrameData', 'hostAudioMuted', 'guestAudioMuted',
                         'hostCameraFacing', 'guestCameraFacing', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCallRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidCallRoom(incoming()) &&
                       existing().status != 'ended' &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Stranger joins a waiting room
                         (existing().status == 'waiting' &&
                          existing().hostId != request.auth.uid &&
                          incoming().guestId == request.auth.uid &&
                          incoming().guestId.size() >= 1 &&
                          incoming().status == 'connected' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'guestId', 'guestName', 'guestCountryCode', 'guestCountryName',
                            'status', 'rtcAnswerSdp', 'guestFrameData', 'guestAudioMuted',
                            'guestCameraFacing', 'updatedAt'
                          ])) ||
                         // Action 2: Host or Guest updates media state / WebRTC signaling
                         ((existing().hostId == request.auth.uid || existing().guestId == request.auth.uid) &&
                          incoming().guestId == existing().guestId &&
                          incoming().status == existing().status &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'rtcOfferSdp', 'rtcAnswerSdp', 'hostFrameData', 'guestFrameData',
                            'hostAudioMuted', 'guestAudioMuted', 'hostCameraFacing',
                            'guestCameraFacing', 'updatedAt'
                          ])) ||
                         // Action 3: Host or Guest ends the call
                         ((existing().hostId == request.auth.uid || existing().guestId == request.auth.uid) &&
                          incoming().guestId == existing().guestId &&
                          incoming().status == 'ended' &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'status', 'updatedAt'
                          ]))
                       );

      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostId == request.auth.uid;

      // 3. ChatMessage Subcollection
      function isValidChatMessage(data) {
        return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
               data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
               data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
               data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
               data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 2 &&
               data.participants[0] is string && data.participants[0].size() <= 128 &&
               data.createdAt is timestamp && data.createdAt <= request.time;
      }

      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(messageId) &&
                      request.auth.uid in existing().participants;

        allow list: if isSignedIn() &&
                       request.auth.uid in existing().participants;

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         request.auth.uid in incoming().participants &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'senderName', 'text', 'participants', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'senderName', 'text', 'participants', 'createdAt'
                         ]) &&
                         isValidChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/call_rooms/$(roomId));

        allow update, delete: if false;
      }
    }
  }
}
