rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. UserProfile Validation Blueprint
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 10 &&
             data.countryName is string && data.countryName.size() >= 1 && data.countryName.size() <= 60 &&
             data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
             data.onlineStatus is string && data.onlineStatus in ['online', 'searching', 'in_call', 'offline'] &&
             data.ageVerified is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;

      allow create: if isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'countryCode', 'countryName',
                         'targetCountryCode', 'onlineStatus', 'ageVerified', 'updatedAt'
                       ]);

      allow delete: if isValidId(userId);

      // 4. ModerationAction Subcollection (Reports & Blocks)
      function isValidModerationAction(data) {
        return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
               data.targetUserId is string && data.targetUserId.size() >= 1 && data.targetUserId.size() <= 128 &&
               data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
               data.actionType is string && data.actionType in ['report', 'block'] &&
               data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 300 &&
               data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
               data.createdAt is timestamp && data.createdAt <= request.time;
      }

      match /moderation_actions/{actionId} {
        allow get: if isValidId(userId) && isValidId(actionId);
        allow list: if isValidId(userId);

        allow create: if isValidId(userId) &&
                         isValidId(actionId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll([
                           'userId', 'targetUserId', 'targetCountryCode',
                           'actionType', 'reason', 'roomId', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'targetUserId', 'targetCountryCode',
                           'actionType', 'reason', 'roomId', 'createdAt'
                         ]) &&
                         isValidModerationAction(incoming());

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(actionId);
      }
    }

    // 2. CallRoom Validation Blueprint
    function isValidCallRoom(data) {
      return data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.hostCountryCode is string && data.hostCountryCode.size() >= 2 && data.hostCountryCode.size() <= 10 &&
             data.hostCountryName is string && data.hostCountryName.size() >= 1 && data.hostCountryName.size() <= 60 &&
             data.targetCountryCode is string && data.targetCountryCode.size() >= 2 && data.targetCountryCode.size() <= 10 &&
             data.guestId is string && data.guestId.size() <= 128 &&
             data.guestName is string && data.guestName.size() <= 60 &&
             data.guestCountryCode is string && data.guestCountryCode.size() <= 10 &&
             data.guestCountryName is string && data.guestCountryName.size() <= 60 &&
             data.status is string && data.status in ['waiting', 'connected', 'ended'] &&
             data.rtcOfferSdp is string && data.rtcOfferSdp.size() <= 5000 &&
             data.rtcAnswerSdp is string && data.rtcAnswerSdp.size() <= 5000 &&
             data.hostFrameData is string && data.hostFrameData.size() <= 8000 &&
             data.guestFrameData is string && data.guestFrameData.size() <= 8000 &&
             data.hostAudioMuted is bool &&
             data.guestAudioMuted is bool &&
             data.hostCameraFacing is string && data.hostCameraFacing in ['front', 'back'] &&
             data.guestCameraFacing is string && data.guestCameraFacing in ['front', 'back'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /call_rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if true;

      allow create: if isValidId(roomId) &&
                       incoming().hostId.size() >= 1 &&
                       incoming().keys().hasAll([
                         'hostId', 'hostName', 'hostCountryCode', 'hostCountryName',
                         'targetCountryCode', 'guestId', 'guestName', 'guestCountryCode',
                         'guestCountryName', 'status', 'rtcOfferSdp', 'rtcAnswerSdp',
                         'hostFrameData', 'guestFrameData', 'hostAudioMuted', 'guestAudioMuted',
                         'hostCameraFacing', 'guestCameraFacing', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostId', 'hostName', 'hostCountryCode', 'hostCountryName',
                         'targetCountryCode', 'guestId', 'guestName', 'guestCountryCode',
                         'guestCountryName', 'status', 'rtcOfferSdp', 'rtcAnswerSdp',
                         'hostFrameData', 'guestFrameData', 'hostAudioMuted', 'guestAudioMuted',
                         'hostCameraFacing', 'guestCameraFacing', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCallRoom(incoming());

      allow update: if isValidId(roomId) &&
                       isValidCallRoom(incoming()) &&
                       incoming().createdAt == existing().createdAt;

      allow delete: if isValidId(roomId);

      // 3. ChatMessage Subcollection
      function isValidChatMessage(data) {
        return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
               data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
               data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
               data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
               data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 2 &&
               data.participants[0] is string && data.participants[0].size() <= 128 &&
               data.createdAt is timestamp && data.createdAt <= request.time;
      }

      match /messages/{messageId} {
        allow get: if isValidId(roomId) && isValidId(messageId);
        allow list: if true;

        allow create: if isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'senderName', 'text', 'participants', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'senderName', 'text', 'participants', 'createdAt'
                         ]) &&
                         isValidChatMessage(incoming());

        allow update, delete: if false;
      }
    }
  }
}
